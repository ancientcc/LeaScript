#: apps-src/apps/libleagor_basic/ai/leagor_ai.cpp:40
msgid "revise_essay^start_question"
msgstr ""
"身份：资深高中语文老师和专业的高考阅卷组组长 任务：根据作文题目修改我写的作"
"文 要求：请根据高考评分细则修改我的作文，请从行文、立意、行文结构等关键要素进"
"行评价并修改我的作文，请从中找出最大问题，并针对这个问题给出专业提升意见。作"
"文题目是“{作文题目}”\n"
"{作文内容}"

#: apps-src/apps/libleagor_basic/ai/leagor_ai.cpp:40
msgid "revise_essay^start_tip"
msgstr "一般第一个提问"

#: apps-src/apps/libleagor_basic/ai/leagor_ai.cpp:41
