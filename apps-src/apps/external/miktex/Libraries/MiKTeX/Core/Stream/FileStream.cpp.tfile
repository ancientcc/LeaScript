#include "../miktex_Core_config.h"

#include <fcntl.h>

#if defined(_MSC_VER) || defined(__MINGW32__)
#  include <io.h>
#endif

// #include <miktex/Core/FileStream>
#include <miktex/Core/FileStream.h>

#include "../miktex_Core_internal.h"

using namespace std;

using namespace MiKTeX::Core;

FileStream::~FileStream() noexcept
{
}

void FileStream::Attach(posix_file_t file)
{
	VALIDATE(file != INVALID_FILE, null_str);
	if (this->fp != INVALID_FILE) {
		Close();
	}
	this->fp = file;
}

void FileStream::Close()
{
	close();
}

size_t FileStream::Read(void* data, size_t count)
{
    return posix_fread(fp, data, count);
}

void FileStream::Write(const void* data, size_t count)
{
    posix_fwrite(fp, data, count);
}

void FileStream::Seek(long offset, SeekOrigin seekOrigin)
{
  int origin;
  switch (seekOrigin)
  {
  case SeekOrigin::Begin:
    origin = RW_SEEK_SET;
    break;
  case SeekOrigin::End:
    origin = RW_SEEK_END;
    break;
  case SeekOrigin::Current:
    origin = RW_SEEK_CUR;
    break;
  default:
    MIKTEX_UNEXPECTED();
    break;
  }
  int64_t ret = posix_fseek2(fp, offset, origin);
  VALIDATE(ret >= 0, null_str);
}

long FileStream::GetPosition() const
{
    long pos = posix_ftell(fp);
    VALIDATE(pos >= 0, null_str);
    return pos;
}

void FileStream::SetBinary()
{
    // do nothing
}
