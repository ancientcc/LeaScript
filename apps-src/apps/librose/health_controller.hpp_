	void refresh_idcontain_chart(tdyn_chartsel& dyn_chartsel, bool redraw_only, const SDL_Point& redraw_which_chart = SDL_Point{nposm, nposm});

	cv::Mat draw_header_mat(bool to_image, int mat_width, double radius, const SDL_Point& map_margin, const SDL_Point& chart_margin,
		const aplt::thealth::thealth_result2& result2);

	cv::Mat draw_sit_mat(bool to_image, int mat_width, double radius, const SDL_Point& map_margin, const SDL_Point& chart_margin, 
