	// tdraw_item stores pointers to cv::Mat objects. 
	// The following are the objects these pointers point to.
	struct tsingle_mat
	{
	public:
		tsingle_mat(int mat_type, int fake_workout_at)
			: mat_type(mat_type)
			, fake_workout_at(fake_workout_at)
			// If 'draw_item_at' is 'nposm', 
			// it means that this tsingle_mat is not present in 'draw_items'.
			, draw_item_at(nposm)
			, share(bool_set_none)
		{
			VALIDATE(mat_type >= 0 && mat_type < mattype_count, null_str);
			VALIDATE(fake_workout_at >= fake_workout_min && fake_workout_at < fake_workout_min + fake_workout_count, null_str);
			memset(btn_rects, 0, sizeof(btn_rects));
			memset(&tip_rects, 0, sizeof(tip_rects));
		}

		~tsingle_mat()
		{
			if (tip_rects.ptr != nullptr) {
				free(tip_rects.ptr);
				tip_rects.ptr = nullptr;
			}
		}

		void clear()
		{
			draw_item_at = nposm;
			memset(btn_rects, 0, sizeof(btn_rects));
			tip_rects.vsize = 0;
			// share = bool_set_none;
		}

	public:
		const int mat_type;
		const int fake_workout_at;
		int draw_item_at;
		cv::Mat mat;
		SDL_Rect btn_rects[pl_btn_count];
		trectdata2_C tip_rects;
		bool_set_t share;
	};

