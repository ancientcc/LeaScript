	bool is_day_chartsel(int sel) const
	{
		return sel == chartsel_today || sel == chartsel_yesterday || sel == chartsel_2daysago;
	}

	bool is_days_chartsel(int sel) const
	{
		return sel == chartsel_15days || sel == chartsel_30days;
	}

	int days_from_days_chartsel(int sel) const
	{
		if (sel == chartsel_15days) {
			return 15;

		} else if (sel == chartsel_30days) {
			return 30;
		}
		VALIDATE(false, null_str);
		return nposm;
	}

	#define chartsel_has_header_mat(sel)	is_day_chartsel(sel)
	#define chartsel_has_sit_mat(sel)		is_day_chartsel(sel)

	inline bool chartsel_has_summary_mat(int sel)
	{
		return sel >= chartsel_dyn_min;
	}

