		int small_font_size, const aplt::thealth::thealth_result2& result2, int workout_at, const tworkout_mat2_C& workout_mat2, 
		SDL_Rect* btn_rects_result, trectdata_C* tip_rects_result, int* rep_steps_result, SDL_Point* chart_margin_lr_result);

	cv::Mat draw_workout_mat2(bool to_image, int mat_width, double radius, const SDL_Point& map_margin, const SDL_Point& chart_margin,
	int small_font_size, const aplt::thealth::thealth_result2& result2, int workout_at, tworkout_mat2_C& workout_mat2);

