	void empty_mat2_rects(tworkout_mat2_C& mat2)
	{
		memset(mat2.btn_rects, 0, sizeof(mat2.btn_rects));

		if (mat2.tip_rects.count != 0) {
			memset(mat2.tip_rects.ptr, 0, sizeof(SDL_Rect) * mat2.tip_rects.count);

		} else {
			VALIDATE(mat2.tip_rects.ptr == nullptr, null_str);
		}
	}

