	telem_array_C draw_items_;

	class tplayer
	{
	public:
		tplayer(health_controller& controller)
			: controller_(controller)
			, workout_(sizeof(uint8_t))
			, workout_at_in_page_(nposm)
			, event_items_(sizeof(aplt::thealth::tevent_item))
			, range_ms_min_(nposm)
			, duration_ms_(nposm)
			, played_ms_(nposm)
			, cursor_(nposm)
			, wkon32_cursor_(nposm)
			, wkon32_frame_at_(nposm)
			, curr_state2_(nullptr)
			, draw_item_(nullptr)
			, interval_(MEDIAPIPE_POSTURE_MIN_INTERVAL)
			// , interval_(20)
			, next_ticks_(0)
		{
			for (int at = 0; at < mediapipe::kNumPoseLandmarks; at ++) {
				nan_landmarks_[at].x = std::numeric_limits<float>::quiet_NaN();
				nan_landmarks_[at].y = std::numeric_limits<float>::quiet_NaN();
			}
			memcpy(last_landmarks_, nan_landmarks_, sizeof(nan_landmarks_));
		}

		~tplayer()
		{
			VALIDATE(!is_ing(), null_str);
		}

		bool set_workout_data(const tuint8data_C& zip_workout, const config& wkoscript_cfg, int workout_at, 
			const aplt::thealth::tevent_item* event_items, int event_item_count);
		telem_array_C& workout_data() { return workout_; }
		int workout_at_in_page() const { return workout_at_in_page_; }

		void start(int width, int height);
		void set_draw_item(tdraw_item& draw_item);
		void stop();
		void restart();
		void seek_to_ratio(double ratio);
		void seek_to_cursor(int played_ms, int cursor);
		bool is_ing() const { return cursor_ != nposm; }
		void make_sure_stop()
		{
			if (is_ing()) {
				stop();
			}
		}

		void pause(bool enter);
		bool is_pausing() const
		{
			VALIDATE(is_ing(), null_str);
			return next_ticks_ == UINT_MAX;
		}

		void step_one(bool backward);
		void update_landmarks_mat_for_redraw();

		bool is_0() const;
		bool is_end() const;
		bool is_time_to_next() const;
		cv::Mat get_mat(bool update_cursor);
		void play_next();

		struct trestorer
		{
		public:
			trestorer(tplayer& player)
				: player_(player)
				, played_ms_(player.played_ms_)
				, cursor_(player.cursor_)
				, wkon32_cursor_(player.wkon32_cursor_)
				, wkon32_frame_at_(player.wkon32_frame_at_)
				, curr_state2_(player.curr_state2_)
				, next_ticks_(player.next_ticks_) // when save, maybe in pausing
			{
				VALIDATE(player_.is_ing(), null_str);
			}

			~trestorer()
			{
				VALIDATE(!player_.is_ing(), null_str);
				player_.controller_.start_player(nposm);
				player_.next_ticks_ = next_ticks_;
				int cursor = cursor_;
				if (cursor == player_.workout_.vsize || player_.is_pausing()) {
					// seek_to_cursor will call player_.play_next, 
					// it require 'cursor_ < player_.workout_.vsize'.
					// played_ms_ -= player_.interval_;

					// int max_duration = played_ms_ - interval_;
					int max_duration = played_ms_;
					player_.check_and_calculate_duration_ex(max_duration);

				} else {
					if (curr_state2_ != player_.curr_state2_) {
						player_.curr_state2_to(curr_state2_);
					}
					player_.seek_to_cursor(played_ms_, cursor);
				}
			}

		private:
			tplayer& player_;
			int played_ms_;
			int cursor_;
			int wkon32_cursor_;
			int wkon32_frame_at_;
			aplt::twkoscript::tstate2* curr_state2_;
			uint32_t next_ticks_;
		};

	private:
		void did_landmarks_mat_changed(cv::Mat& result);

		// Does not include the landmark pointed to by 'max_duration'.
		SDL_Point check_and_calculate_duration(int max_duration, int* curr_flow_state) const;
		void check_and_calculate_duration_ex(int max_duration);
		bool parse_non_landmarks_bytes();

		// Include the frame pointed to by 'target_frame'.
		bool move_wkon32_cursor_to_frame_at(int target_frame_at);
		void curr_state2_to(aplt::twkoscript::tstate2* new_state2);

	private:
		health_controller& controller_;
		SDL_FPoint nan_landmarks_[mediapipe::kNumPoseLandmarks];
		SDL_FPoint last_landmarks_[mediapipe::kNumPoseLandmarks];
		telem_array_C workout_;
		config wkoscript_cfg_;
		int workout_at_in_page_;
		telem_array_C event_items_;
		aplt::twkoscript script_;
		int range_ms_min_;
		SDL_Size mat_size_;
		SDL_Rect video_clip_;
		int duration_ms_;
		int played_ms_;
		int cursor_;
		int wkon32_cursor_;
		int wkon32_frame_at_;

		aplt::twkoscript::tstate2* curr_state2_;
		tdraw_item* draw_item_;

		const int interval_;
		uint32_t next_ticks_;
	};
	tplayer player_;

	class tclear_interest_hiting_lock
	{
	public:
		tclear_interest_hiting_lock(health_controller& controller)
			: controller_(controller)
			, may_empty_tip_mat_(false)
			, tip_mat_is_update_(false)
		{}

		~tclear_interest_hiting_lock()
		{
			controller_.interest_hiting_.clear();

			if (may_empty_tip_mat_ && !tip_mat_is_update_ && !controller_.tip_mat_.empty()) {
				controller_.clear_tip_mat();
			}
		}

		void set_may_empty_tip_mat()
		{
			VALIDATE(!may_empty_tip_mat_, null_str);
			may_empty_tip_mat_ = true;
		}

		void set_tip_mat_is_update()
		{
			VALIDATE(!tip_mat_is_update_, null_str);
			tip_mat_is_update_ = true;
		}

	private:
		health_controller& controller_;
		bool may_empty_tip_mat_;
		bool tip_mat_is_update_;
	};
	struct tinterest_hiting
	{
	public:
		tinterest_hiting(health_controller& controller)
			: controller_(controller)
		{
			clear();
		}

		void set(const tclick& _click)
		{
			VALIDATE(_click.workout_at_in_page >= 0, null_str);
			if (_click.workout_at_in_page < fake_workout_min) {
				VALIDATE(_click.workout_at_in_page < controller_.workout_mat2s_.vsize, null_str);

			} else {
				VALIDATE(_click.workout_at_in_page <= fake_workout_max, null_str);
			}
			
			VALIDATE(_click.type >= 0 && _click.type < clicktype_count, null_str);
			if (_click.type == clicktype_btn) {
				VALIDATE(is_my_btn_all(_click.ctx), null_str);
			}
			click = _click;
		}

		void clear()
		{
			click.workout_at_in_page = nposm;
			click.type = nposm;
			click.ctx = nposm;
		}
		bool valid() const { return click.ctx != nposm; }

		bool in_progressbar() const { return click.type == clicktype_btn && click.ctx == pl_btn_progressbar; }

	public:
		tclick click;

	private:
		health_controller& controller_;
	};
	tinterest_hiting interest_hiting_;

	class thide_cairo_share_lock
	{
	public:
		thide_cairo_share_lock(health_controller& controller)
			: controller_(controller)
		{
			VALIDATE(!controller_.hide_cairo_share_, null_str);
			controller_.hide_cairo_share_ = true;
		}

		~thide_cairo_share_lock()
		{
			VALIDATE(controller_.hide_cairo_share_, null_str);
			controller_.hide_cairo_share_ = false;
		}

	private:
		health_controller& controller_;
	};
	bool hide_cairo_share_;

	tmat_loader mat_loader_;
};

