#define is_my_btn_all(btn) \
	((btn) == pl_btn_play  || (btn) == pl_btn_step_backward || (btn) == pl_btn_step_forward || (btn) == pl_btn_stop || (btn) == pl_btn_progressbar || (btn) == pl_btn_share)

#define is_my_btn_when_nonpausing(btn) \
	((btn) == pl_btn_play || (btn) == pl_btn_stop || (btn) == pl_btn_progressbar || (btn) == pl_btn_share)

	// enum {btn_play, btn_stop, btn_progressbar, btn_count};
	struct tworkout_mat2_C
	{
		tuint8data_C zip_workout;
		tchardata_C wkoscript_cfg_data;
		config* wkoscript_cfg;
		aplt::thealth::tevent_item* wkon32_event_items;
		int wkon32_event_item_count;
		cv::Mat* workout_mat;
		cv::Mat* landmarks_mat;
		SDL_Rect btn_rects[pl_btn_count];
		SDL_Rect play_1th_rect;
		trectdata_C tip_rects;
		int rep_steps[WORKOUT_MAX_FLOW_STATES];
		SDL_Point chart_margin_lr;
		SDL_Range range_ms;
		bool_set_t share;
	};

	void free_mat2_data(tworkout_mat2_C& mat2)
	{
		if (mat2.zip_workout.ptr != nullptr) {
			free(mat2.zip_workout.ptr);
			mat2.zip_workout.ptr = nullptr;
		}
		if (mat2.wkoscript_cfg_data.ptr != nullptr) {
			free(mat2.wkoscript_cfg_data.ptr);
			mat2.wkoscript_cfg_data.ptr = nullptr;
		}
		if (mat2.wkoscript_cfg != nullptr) {
			delete mat2.wkoscript_cfg;
			mat2.wkoscript_cfg = nullptr;
		}
		if (mat2.wkon32_event_items != nullptr) {
			free(mat2.wkon32_event_items);
			mat2.wkon32_event_items = nullptr;
		}
		if (mat2.workout_mat != nullptr) {
			delete mat2.workout_mat;
			mat2.workout_mat = nullptr;
		}
		if (mat2.landmarks_mat != nullptr) {
			delete mat2.landmarks_mat;
			mat2.landmarks_mat = nullptr;
		}
		if (mat2.tip_rects.ptr != nullptr) {
			free(mat2.tip_rects.ptr);
			mat2.tip_rects.ptr = nullptr;
		}
		memset(&mat2, 0, sizeof(mat2));
	}

	void set_workout_mat2_data(tworkout_mat2_C& mat2, const uint8_t* zip_workout_data, int zip_workout_len,
		const char* wkoscript_cfg_data, int wkoscript_cfg_len, const aplt::thealth::tevent_item* wkon32_event_items, int wkon32_event_item_count)
	{
		VALIDATE(mat2.zip_workout.ptr == nullptr, null_str);
		VALIDATE(mat2.wkoscript_cfg_data.ptr == nullptr, null_str);
		VALIDATE(mat2.wkoscript_cfg == nullptr, null_str);
		VALIDATE(mat2.wkon32_event_items == nullptr, null_str);
		VALIDATE(mat2.workout_mat == nullptr, null_str);
		VALIDATE(mat2.landmarks_mat == nullptr, null_str);

		// don't modify some field, for example: 'share'
		// memset(&mat2, 0, sizeof(mat2));

		if (zip_workout_data != nullptr) {
			VALIDATE(zip_workout_len != 0, null_str);
			mat2.zip_workout.ptr = (uint8_t*)malloc(zip_workout_len);
			memcpy(mat2.zip_workout.ptr, zip_workout_data, zip_workout_len);
			mat2.zip_workout.len = zip_workout_len;
		}
		if (wkoscript_cfg_data != nullptr) {
			if (wkoscript_cfg_len != 0) {
				mat2.wkoscript_cfg_data.ptr = (char*)malloc(wkoscript_cfg_len);
				memcpy(mat2.wkoscript_cfg_data.ptr, wkoscript_cfg_data, wkoscript_cfg_len);
				mat2.wkoscript_cfg_data.len = wkoscript_cfg_len;

				mat2.wkoscript_cfg = new config;
				aplt::read_config_ex(std::string(mat2.wkoscript_cfg_data.ptr, mat2.wkoscript_cfg_data.len), *mat2.wkoscript_cfg);
			}
		}
		VALIDATE(wkon32_event_items != nullptr && wkon32_event_item_count > 0, null_str);
		int s = wkon32_event_item_count * sizeof(aplt::thealth::tevent_item);
		mat2.wkon32_event_items = (aplt::thealth::tevent_item*)malloc(s);
		memcpy(mat2.wkon32_event_items, wkon32_event_items, s);
		mat2.wkon32_event_item_count = wkon32_event_item_count;
	}

	void clear_workout_mat2s()
	{
		tworkout_mat2_C* mat2s = (tworkout_mat2_C*)workout_mat2s_.data;
		for (int at = 0; at < workout_mat2s_.vsize; at ++) {
			tworkout_mat2_C& mat2 = mat2s[at];
			free_mat2_data(mat2);
		}
		workout_mat2s_.clear();
	}

	void clear_tip_mat2()
	{
		if (!tip_mat_.empty()) {
			clear_tip_mat();
		}
	}

	void clear_dyn_chartsels()
	{
		for (std::vector<tdyn_chartsel*>::iterator it = dyn_chartsels_.begin(); it != dyn_chartsels_.end(); ++ it) {
			tdyn_chartsel* chartsel = *it;
			delete chartsel;
		}
		dyn_chartsels_.clear();
	}

	void calculate_share_workout_count(tdyn_chartsel& dyn_chartsel) const;
	std::string default_status_msg() const;

private:
