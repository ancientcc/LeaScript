	void set_workout_mat2s_share(bool_set_t share)
	{
		tworkout_mat2_C* mat2s = (tworkout_mat2_C*)workout_mat2s_.data;
		for (int mat2_at = 0; mat2_at < workout_mat2s_.vsize; mat2_at ++) {
			tworkout_mat2_C& mat2 = mat2s[mat2_at];
			mat2.share = share;
		}
	}

