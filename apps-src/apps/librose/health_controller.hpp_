class LRUCache
{
public:
    // Constructor: set the maximum cache size N.
    explicit LRUCache(size_t capacity) 
		: capacity_(capacity)
	{}

    // 1. Get cached item: pass an int ID, return the corresponding cv::Mat.
    // If not found, return an empty cv::Mat.
    cv::Mat get(int key)
	{
        // std::lock_guard<std::mutex> lock(mutex_);
        
        auto it = cache_map_.find(key);
        if (it == cache_map_.end()) {
            // Not found, return an empty Mat.
            return cv::Mat(); 
        }

        // Hit: move the current node to the head of the list (indicating it was most recently used).
        // std::list::splice is an O(1) operation, which is much faster than deleting and then inserting.
        cache_list_.splice(cache_list_.begin(), cache_list_, it->second);
        
        // Return the stored image data.
        return it->second->second; 
    }

    // 2. Store in cache: pass an ID and the corresponding cv::Mat.
    void put(int key, const cv::Mat& mat)
	{
        // std::lock_guard<std::mutex> lock(mutex_);

        // Case A: If the key already exists in the cache.
        auto it = cache_map_.find(key);
        if (it != cache_map_.end()) {
            // Update the Mat data 
			// (note: must clone to prevent external destruction from reclaiming the data, or shallow copying causing the original data to be modified).
            it->second->second = mat.clone(); 
            // Move to the head of the list.
            cache_list_.splice(cache_list_.begin(), cache_list_, it->second);
            return;
        }

        // Case B: If the cache is full, evict the least recently used node (at the tail of the list).
        if (cache_map_.size() >= capacity_)
		{
            // Get the node at the end of the list.
            auto last_node = cache_list_.end();
            last_node--; 
            
            // 1. Remove the corresponding record from the hash table (using the node's key field).
            cache_map_.erase(last_node->first);
            
            // 2. Remove the node from the list (the node's destructor will automatically release the internal cv::Mat memory).
            cache_list_.erase(last_node);
        }

        // Case C: Insert new data at the head of the list.
        // Note: Must clone(); the cached data is an independent memory copy.
        cache_list_.push_front({key, mat.clone()}); 
        // Record the iterator position of this node in the list.
        cache_map_[key] = cache_list_.begin();
    }

    // 3. Helper function: Get the current cache size.
    size_t size() const
	{
        // std::lock_guard<std::mutex> lock(mutex_);
        return cache_map_.size();
    }

    // 4. Helper function: Clear the cache (suitable for calling when reloading data).
    void clear()
	{
        // std::lock_guard<std::mutex> lock(mutex_);
        cache_list_.clear();
        cache_map_.clear();
    }

    // 5. Helper function: Manually evict an ID (e.g., when data has been updated and needs a forced refresh).
    void remove(int key)
	{
        // std::lock_guard<std::mutex> lock(mutex_);
        auto it = cache_map_.find(key);
        if (it != cache_map_.end()) {
            cache_list_.erase(it->second);
            cache_map_.erase(it);
        }
    }

private:
    size_t capacity_;                  // Maximum cache size (e.g., N=5).
    // mutable std::mutex mutex_;         // Mutex to ensure thread safety.

    // List node: stores <record ID, image data>.
    using Node = std::pair<int, cv::Mat>;
    // Doubly linked list container.
    std::list<Node> cache_list_;
    // Hash table: record ID -> iterator to the corresponding node in the list (enabling O(1) lookups).
    std::unordered_map<int, typename std::list<Node>::iterator> cache_map_;
};

class tmat_loader
{
public:
    tmat_loader() 
		: image_cache_(MAX_CACHE_NUM) 
	{} // MAX_CACHE_NUM is recommended to be set to 4 or 5.

    // Interface exposed to the UI thread: retrieve cv::Mat by ID.
    cv::Mat getChartMat(int record_id)
	{
        // 1. Try to retrieve from the cache.
        cv::Mat cached_mat = image_cache_.get(record_id);
        if (!cached_mat.empty()) {
			// Return directly; at this point, the LRU cache has already moved this ID to the front internally.
            return cached_mat;
        }

        // 2. Cache miss; the image needs to be generated in a background thread. For now, return empty and notify the UI to show a loading state.
        // In a real project, you would send a generation task to a task queue.
        // triggerGenerateTask(record_id);
        return cv::Mat(); 
    }

    // Callback function: called when the image generated in the background thread is ready.
    void onChartGenerated(int record_id, cv::Mat generated_mat)
	{
        // 3. Insert the newly generated Mat into the cache.
        // Note: The generated Mat here must be converted from ARGB to CV_8UC3, and its format must match the UI requirements.
        image_cache_.put(record_id, generated_mat);

        // 4. Notify the UI thread to update the interface.
        // NotifyUIThreadToRefresh(record_id);
    }

private:
    const int MAX_CACHE_NUM = 4; // Assume your limit is only 4 items.
    LRUCache image_cache_;
};

class health_controller: public base_controller, public events::mouse_handler_base
{
public:
	enum {chartsel_today, chartsel_yesterday, chartsel_2daysago, 
		chartsel_15days, chartsel_30days, chartsel_fixed_count, chartsel_dyn_min = chartsel_fixed_count};

	struct tdyn_chartsel
	{
	public:
		tdyn_chartsel()
			: type(nposm)
			, snapshot_size({nposm, nposm})
			, workout_at2s(sizeof(tworkout_at2))
		{
			memset(time_s, 0, sizeof(time_s));
			memset(day_offset_ys, 0, sizeof(day_offset_ys));
			memset(workout_durations, 0, sizeof(workout_durations));
			memset(workout_count, 0, sizeof(workout_count));
			memset(share_workout_count, 0, sizeof(share_workout_count));
			memset(max_range, 0, sizeof(max_range));

			memset(result2s, 0, sizeof(result2s));
		}

		~tdyn_chartsel()
		{
			clear();
		}

		void set_idcontain_rule(const std::string& _key)
		{
			VALIDATE(!_key.empty(), null_str);
			type = dyncharttype_idcontain;
			key = _key;

			clear();
		}

		bool valid() const { return type != nposm && !key.empty(); }

		void to_pref(config& cfg) const;
		void from_pref(const config& cfg);
		void clear_pref()
		{
			type = nposm;
			key.clear();
		}

		std::string title() const;
		std::string chart_title() const;

		void clear()
		{
			snapshot_size = SDL_Size{0, 0};
			memset(time_s, 0, sizeof(time_s));
			memset(day_offset_ys, 0, sizeof(day_offset_ys));
			memset(workout_durations, 0, sizeof(workout_durations));
			memset(workout_count, 0, sizeof(workout_count));
			memset(share_workout_count, 0, sizeof(share_workout_count));
			memset(max_range, 0, sizeof(max_range));

			int count = sizeof(result2s) / sizeof(result2s[0]);
			for (int at = 0; at < count; at ++) {
				if (result2s[at] != nullptr) {
					delete result2s[at];
					result2s[at] = nullptr;
				}
			}

			workout_at2s.clear();
		}

	public:
		int type;
		std::string key;

		SDL_Size snapshot_size;
		time_t time_s[MAX_HEALTH_DAYS];
		int day_offset_ys[MAX_HEALTH_DAYS];
		int workout_durations[MAX_HEALTH_DAYS];
		int workout_count[MAX_HEALTH_DAYS];
		int share_workout_count[MAX_HEALTH_DAYS];
		SDL_Range max_range[MAX_HEALTH_DAYS];

		aplt::thealth::thealth_result2* result2s[MAX_HEALTH_DAYS];

		struct tworkout_at2
		{
			int day_at;
			int workout_at;
		};
		telem_array_C workout_at2s;
	};

	health_controller(trhealth_scene_slot& scene_slot, const config &app_cfg, CVideo& video,
