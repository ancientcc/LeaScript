LOCAL_PATH := $(call my-dir)/../../../..

include $(CLEAR_VARS)

LOCAL_MODULE := 3rdparty

LOCAL_CFLAGS := -DBORINGSSL_SHARED_LIBRARY -DBORINGSSL_IMPLEMENTATION -DBORINGSSL_ALLOW_CXX_RUNTIME -DBORINGSSL_NO_STATIC_INITIALIZER -DOPENSSL_SMALL -DOPENSSL_NO_ASM

LOCAL_CFLAGS += -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS -DBUILD_3RDPARTY
LOCAL_CFLAGS += -mfpu=neon -O3
# opencv
LOCAL_CFLAGS += -DCVAPI_EXPORTS -D__OPENCV_BUILD=1 -DWITH_CUDA=OFF -DOPENCV_ENABLE_NONFREE

LOCAL_CPPFLAGS += -Wno-inconsistent-missing-override -Wno-nonportable-include-path -Wno-narrowing -DGOOGLE_PROTOBUF_DONT_USE_UNALIGNED
LOCAL_CPPFLAGS += -std=c++17

LOCAL_CPP_EXTENSION := .cxx .cpp .cc

LOCAL_C_INCLUDES := $(LOCAL_PATH)/external/3rdparty \
	$(LOCAL_PATH)/external/boost \
	$(LOCAL_PATH)/external/boringssl/include \
	$(LOCAL_PATH)/external/libros/assimp/code \
	$(LOCAL_PATH)/external/libros/include \
	$(LOCAL_PATH)/external/libros/nlopt/include \
	$(LOCAL_PATH)/external/opencv \
	$(LOCAL_PATH)/external/opencv/3rdparty/carotene/include \
	$(LOCAL_PATH)/external/opencv/autogenerated \
	$(LOCAL_PATH)/external/protobuf/src \
	$(LOCAL_PATH)/external/tensorflow/tensorflow/lite/downloads/eigen \
	$(LOCAL_PATH)/external/zlib \
	$(LOCAL_PATH)/../linker/include/SDL2 \
	$(LOCAL_PATH)/../linker/include/SDL2_image \
	$(LOCAL_PATH)/../linker/include/SDL2_mixer \
	$(LOCAL_PATH)/../linker/include/SDL2_ttf

LOCAL_SRC_FILES := \
	$(subst $(LOCAL_PATH)/,, \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/*.c) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/*.cpp) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/bzip2/*.c) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/bzip2/*.cpp) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/lua/*.c) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/lua/*.cpp) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/lz4/lib/lz4.c) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/chrono/src/*.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/iostreams/src/*.c) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/iostreams/src/*.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/regex/src/*.c) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/regex/src/*.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/thread/src/*.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/archive_exception.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/basic_archive.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/basic_iarchive.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/basic_iserializer.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/basic_oarchive.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/basic_oserializer.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/basic_pointer_iserializer.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/basic_pointer_oserializer.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/basic_serializer_map.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/binary_iarchive.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/binary_oarchive.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/codecvt_null.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/extended_type_info.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/extended_type_info_no_rtti.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/extended_type_info_typeid.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/stl_port.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/utf8_codecvt_facet.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/serialization/src/void_cast.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/thread/src/pthread/thread.cpp) \
	$(wildcard $(LOCAL_PATH)/external/boost/libs/thread/src/pthread/once_atomic.cpp) \
	$(wildcard $(LOCAL_PATH)/external/gettext/gettext-runtime/intl/*.c) \
	$(wildcard $(LOCAL_PATH)/external/gettext/gettext-runtime/intl/*.cpp) \
	$(wildcard $(LOCAL_PATH)/external/libiconv/lib/*.c) \
	$(wildcard $(LOCAL_PATH)/external/libiconv/lib/*.cpp) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/libb64/src/cdecode.c) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/libb64/src/cencode.c) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/tinyxml/tinyxml.cpp) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/tinyxml/tinyxmlerror.cpp) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/tinyxml/tinyxmlparser.cpp) \
	$(wildcard $(LOCAL_PATH)/external/3rdparty/tinyxml2/tinyxml2.cpp))


include $(LOCAL_PATH)/external/boringssl/Android.mk
include $(LOCAL_PATH)/external/opencv/Android.mk
include $(LOCAL_PATH)/external/protobuf/Android.mk

# app extra external mk will insert after it
include $(LOCAL_PATH)/external/3rdparty/ompl/Android.mk
include $(LOCAL_PATH)/external/libros/assimp/Android.mk
include $(LOCAL_PATH)/external/libros/fcl/Android.mk
include $(LOCAL_PATH)/external/libros/nlopt/Android.mk
include $(LOCAL_PATH)/external/libros/orocos_kdl/Android.mk
include $(LOCAL_PATH)/external/libros/Android.mk
# moveit_[xxx] trac_ik
include $(LOCAL_PATH)/external/libros/Android-moveit.mk

ifneq ($(filter $(NDK_KNOWN_DEVICE_ABI64S),$(TARGET_ARCH_ABI)),)
# 64-bit ABIs
LOCAL_LDFLAGS += -L$(LOCAL_PATH)/../linker/android/lib/arm64-v8a -L$(LOCAL_PATH)/../linker/android/lib-android-private/arm64-v8a
else
# 32-bit ABIs
LOCAL_LDFLAGS += -L$(LOCAL_PATH)/../linker/android/lib/armeabi-v7a -L$(LOCAL_PATH)/../linker/android/lib-android-private/armeabi-v7a
endif

LOCAL_LDLIBS := -lz -llog -landroid -lOpenSLES -lSDL2 -lSDL2_image -lSDL2_mixer -lSDL2_ttf
LOCAL_SHORT_COMMANDS := true

include $(BUILD_SHARED_LIBRARY)