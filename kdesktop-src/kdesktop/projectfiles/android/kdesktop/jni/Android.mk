LOCAL_PATH := $(call my-dir)/../../../..

include $(CLEAR_VARS)

LOCAL_MODULE := main

LOCAL_CFLAGS := -DWEBRTC_LINUX -DWEBRTC_ANDROID -DWEBRTC_POSIX -DWEBRTC_NS_FIXED -DWEBRTC_APM_DEBUG_DUMP=0 -DWEBRTC_INTELLIGIBILITY_ENHANCER=0 \
-DWEBRTC_CODEC_ISACFX -DHAVE_SCTP -DHAVE_WEBRTC_VIDEO -DHAVE_WEBRTC_VOICE \
-DWEBRTC_INCLUDE_INTERNAL_AUDIO_DEVICE -DWEBRTC_USE_BUILTIN_ISAC_FIX=1 -DWEBRTC_USE_BUILTIN_ISAC_FLOAT=0 \
-DBORINGSSL_SHARED_LIBRARY -DBORINGSSL_ALLOW_CXX_RUNTIME -DBORINGSSL_NO_STATIC_INITIALIZER -DOPENSSL_SMALL -DOPENSSL_NO_ASM \
-DWEBRTC_THREAD_RR -DWEBRTC_OPUS_SUPPORT_120MS_PTIME=1 \
-DNO_TCMALLOC

LOCAL_CFLAGS += -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
ifneq ($(filter $(NDK_KNOWN_DEVICE_ABI64S),$(TARGET_ARCH_ABI)),)
# 64-bit ABIs
LOCAL_CFLAGS += -DWEBRTC_ARCH_ARM64
else
# 32-bit ABIs
LOCAL_CFLAGS += -DWEBRTC_ARCH_ARM -DWEBRTC_ARCH_ARM_V7
endif
LOCAL_CFLAGS += -DWEBRTC_HAS_NEON -DWEBRTC_BUILD_LIBEVENT
LOCAL_CFLAGS += -O3
# opencv
LOCAL_CFLAGS += -D__OPENCV_BUILD=1 -DWITH_CUDA=OFF
# tensorflow lite
LOCAL_CFLAGS += -DEIGEN_MPL2_ONLY -DFLATBUFFERS_LOCALE_INDEPENDENT=1 -DRUY_HAVE_CPUINFO -DCPUINFO_LOG_LEVEL=2 -DTFL_STATIC_LIBRARY_BUILD -DTFLITE_MMAP_DISABLED -DPTHREADPOOL_USE_FASTPATH=1 -DTFLITE_WITH_RUY -DFXDIV_USE_INLINE_ASSEMBLY=0
# mediapipe
LOCAL_CFLAGS += -DMEDIAPIPE_MOBILE -DMEDIAPIPE_BUILD_STATIC_LIBS -DTFL_STATIC_LIBRARY_BUILD -DMEDIAPIPE_DISABLE_GPU=1
# miktex
LOCAL_CFLAGS += -DpdfTeX -DMIKTEX -DMIKTEX_UNIX -DLUATEX_HARFBUZZ_ENABLED
# mupdf
LOCAL_CFLAGS += -DZXING_EXPERIMENTAL_API -DHAVE_ZXINGCPP=1
# zstd
LOCAL_CFLAGS += -DZSTD_STATIC_LINKING_ONLY -DZSTD_DISABLE_ASM
# app extra LOCAL_CFLAGS will insert after it
LOCAL_CFLAGS += -DWITH_OPENSSL

LOCAL_CPPFLAGS += -Wno-inconsistent-missing-override -Wno-nonportable-include-path -Wno-narrowing -Wno-enum-constexpr-conversion -DGOOGLE_PROTOBUF_DONT_USE_UNALIGNED
LOCAL_CPPFLAGS += -std=c++17

LOCAL_CPP_EXTENSION := .cxx .cpp .cc

LOCAL_C_INCLUDES := $(LOCAL_PATH)/external/3rdparty \
	$(LOCAL_PATH)/external/3rdparty/cairo/include \
	$(LOCAL_PATH)/external/3rdparty/cpuinfo/include \
	$(LOCAL_PATH)/external/3rdparty/cpuinfo/src \
