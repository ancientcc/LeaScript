	$(LOCAL_PATH)/external/3rdparty/usrsctplib \
	$(LOCAL_PATH)/external/3rdparty/zlib \
	$(LOCAL_PATH)/external/3rdparty/zxing \
	$(LOCAL_PATH)/external/base/third_party/libevent/android \
