void test_new_sdl_api()
{
	std::string file;
	if (game_config::os == os_android) {
		file = "/sdcard/apk/test_SDL_SetTimes.png";

	} else {
		file = game_config::preferences_dir + "/test_SDL_SetTimes.png";
	}

	time_t now = time(nullptr);
	bool ret = SDL_SetTimes(file.c_str(), now - 2, now - 1, now);
	SDL_Log("SDL_SetTimes(file: %s), ret: %s", file.c_str(), ret? "true": "false");

	std::string dir;
	if (game_config::os == os_android) {
		dir = "/sdcard/apk/test_SDL_SetTimers";
	} else {
		dir = game_config::preferences_dir + "/test_SDL_SetTimers";
	}
	ret = SDL_SetTimes(dir.c_str(), now + 1, now + 2, now + 3);
	SDL_Log("SDL_SetTimes(dir: %s), ret: %s", dir.c_str(), ret? "true": "false");

	time_t creation_time = 0;
	time_t last_access_time = 0;
	time_t last_write_time = file_3times(file, &creation_time, &last_access_time);
	SDL_Log("file_3times(file: %s), create: %s, access: %s, write: %s", file.c_str(), 
		utils::format_time_ymdhms(creation_time).c_str(),
		utils::format_time_ymdhms(last_access_time).c_str(),
		utils::format_time_ymdhms(last_write_time).c_str());

	creation_time = 0;
	last_access_time = 0;
	last_write_time = file_3times(dir, &creation_time, &last_access_time);
	SDL_Log("file_3times(dir: %s), create: %s, access: %s, write: %s", dir.c_str(), 
		utils::format_time_ymdhms(creation_time).c_str(),
		utils::format_time_ymdhms(last_access_time).c_str(),
		utils::format_time_ymdhms(last_write_time).c_str());

	std::string pref_file;
	if (game_config::os == os_android) {
		pref_file = "/sdcard/apk/bookmarks1.html";
	} else {
		pref_file = game_config::preferences_dir + "/bookmarks1.html";
	}
	std::string d_file;
	if (game_config::os == os_android) {
		d_file = "/sdcard/apk1/bookmarks2.html";
	} else {
		d_file = "d:/backup20251001/bookmarks2.html";
	}
	ret = SDL_MoveFile(pref_file.c_str(), d_file.c_str());
	SDL_Log("SDL_MoveFile: %s", ret? "true": "false");

	creation_time = 0;
	last_access_time = 0;
	last_write_time = file_3times(d_file, &creation_time, &last_access_time);
	SDL_Log("file_3times(d_file: %s), create: %s, access: %s, write: %s", d_file.c_str(), 
		utils::format_time_ymdhms(creation_time).c_str(),
		utils::format_time_ymdhms(last_access_time).c_str(),
		utils::format_time_ymdhms(last_write_time).c_str());

	unsigned long attributes = SDL_GetAttributes(file.c_str());
	SDL_Log("{SDL_GetAttributes}pre, file: %s, attributes: 0x%08lx", file.c_str(), attributes);
#ifdef _WIN32
	attributes |= FILE_ATTRIBUTE_READONLY;
	// attributes &= ~FILE_ATTRIBUTE_READONLY;
#else
	mode_t newAttributes = S_IRUSR | S_IRGRP | S_IROTH;
	// newAttributes |= S_IWUSR | S_IWGRP | S_IWOTH;

	attributes = newAttributes;
#endif
	ret = SDL_SetAttributes(file.c_str(), attributes);
	attributes = SDL_GetAttributes(file.c_str());
	SDL_Log("{SDL_GetAttributes}set: %s, post, file: %s, attributes: 0x%08lx", ret? "true": "false", file.c_str(), attributes);

	attributes = SDL_GetAttributes(dir.c_str());
	SDL_Log("{SDL_GetAttributes}pre, dir: %s, attributes: 0x%08lx", dir.c_str(), attributes);
#ifdef _WIN32
	attributes |= FILE_ATTRIBUTE_READONLY;
	// attributes &= ~FILE_ATTRIBUTE_READONLY;
#else
	newAttributes = S_IRUSR | S_IRGRP | S_IROTH;
	// newAttributes |= S_IWUSR | S_IWGRP | S_IWOTH;

	attributes = newAttributes;
#endif
	ret = SDL_SetAttributes(dir.c_str(), attributes);
	attributes = SDL_GetAttributes(dir.c_str());
	SDL_Log("{SDL_GetAttributes}set: %s, post, dir: %s, attributes: 0x%08lx", ret? "true": "false", dir.c_str(), attributes);
}

